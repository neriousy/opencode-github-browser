{
  "name": "opencode-github-browser",
  "version": "0.1.0",
  "description": "Browse GitHub issues, pull requests, discussions, and diffs inside the OpenCode 2 TUI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neriousy/opencode-github-browser.git"
  },
  "homepage": "https://github.com/neriousy/opencode-github-browser#readme",
  "bugs": "https://github.com/neriousy/opencode-github-browser/issues",
  "keywords": ["opencode", "opencode-plugin", "github", "tui"],
  "type": "module",
  "files": ["index.ts", "rpc.ts", "src/server", "src/shared", "dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./rpc.ts"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsgo --noEmit",
    "effect:prepare": "./scripts/prepare-effect.sh",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-19157",
    "@opencode-ai/schema": "0.0.0-beta-19157",
    "@tanstack/query-core": "5.102.8",
    "effect": "4.0.0-rc.112",
    "marked": "17.0.1",
    "string-width": "7.2.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/theme": "0.0.0-beta-19157",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "solid-js": "1.9.12",
    "@opencode-ai/client": "0.0.0-beta-19157"
  }
}
